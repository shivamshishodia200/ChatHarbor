<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ChatHarbor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_main" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conversational WhatsApp Importer"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="16dp"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvUserSession"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signed in as: Alice Smith (Acme Corporation)"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSignOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Switch Account"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="20dp"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Export File"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick an exported WhatsApp .txt file directly from device storage or share from WhatsApp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="6dp" />

        <Button
            android:id="@+id/btnPickFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Browse .txt Export File"
            android:backgroundTint="@color/primary"
            android:textColor="#ffffff"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</LinearLayout>
